PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# JWT Configuration
# Genera un secreto seguro y aleatorio de al menos 32 caracteres ejecutando en tu terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA uses claves por defecto ni subas el archivo .env a control de versiones.
JWT_SECRET=tu_clave_secreta_jwt_minimo_32_caracteres_aleatorios_aqui

# Email del Docente autorizado
# Para crear o actualizar la contraseña de la cuenta del docente de forma segura,
# ejecuta el script de aprovisionamiento en el servidor:
# ADMIN_INITIAL_PASSWORD="tu_password_seguro_min_8_caracteres" npm run provision:admin
ADMIN_EMAIL=u20232218369@usco.edu.co

# Orígenes permitidos para CORS (Frontend en Vercel o local)
# En staging o producción, especifique el dominio exacto generado por Vercel, e.g. https://curso-java.vercel.app
# Puede separar múltiples orígenes con comas.
CORS_ORIGIN=http://localhost:5173
